# Docker/server
DEMO_API_TOKEN=change-me
ADMIN_TOKEN=change-me-too
LOG_LEVEL=info
TRACK_TTL_MS=1800

# Android build values belong in android/local.properties or CI secrets:
# ARCORE_API_KEY=...
# DEFAULT_SERVER_URL=http://192.168.1.20:8080
# DEFAULT_API_TOKEN=change-me

# Upper bound after gzip decompression (zip-bomb protection)
MAX_SCAN_UNCOMPRESSED_BYTES=33554432
