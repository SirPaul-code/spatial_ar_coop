# Spatial AR Coop server
# Leave ADMIN_TOKEN empty on first start to generate a cryptographically random token
# in the persistent /data/server.json identity file. Read it with:
#   docker compose exec spatial-server npm run identity
ADMIN_TOKEN=
SPATIAL_SERVER_ID=
SPATIAL_SERVER_NAME=Spatial AR Server

# Recommended: keep the container bound to localhost and publish it through
# Tailscale Serve HTTPS. Set SPATIAL_PUBLIC_URL to that https://*.ts.net URL so
# generated map invites are immediately usable from other devices.
SPATIAL_BIND_IP=127.0.0.1
SPATIAL_PORT=8080
SPATIAL_PUBLIC_URL=

LOG_LEVEL=info
TRACK_TTL_MS=1800
MAX_SCAN_CHUNK_BYTES=8388608

# Android build values belong in android/local.properties or CI secrets:
# sdk.dir=/absolute/path/to/Android/sdk
# ARCORE_API_KEY=...
# DEFAULT_SERVER_URL=https://your-server.your-tailnet.ts.net
# DEFAULT_API_TOKEN=
