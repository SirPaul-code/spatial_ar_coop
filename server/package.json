{
  "name": "spatial-ar-coop-server",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "identity": "node src/identity-cli.mjs",
    "test": "node -e \"const{readdirSync}=require('node:fs');const{spawnSync}=require('node:child_process');const files=readdirSync('test').filter(f=>f.endsWith('.test.mjs')).map(f=>'test/'+f);const r=spawnSync(process.execPath,['--test','--test-reporter=spec',...files],{stdio:'inherit'});if(r.error)throw r.error;process.exit(r.status??1)\"",
    "check": "node -e \"const{readdirSync}=require('node:fs');const{spawnSync}=require('node:child_process');for(const d of ['src','test'])for(const f of readdirSync(d)){if(!f.endsWith('.mjs'))continue;const r=spawnSync(process.execPath,['--check',d+'/'+f],{stdio:'inherit'});if(r.error)throw r.error;if(r.status!==0)process.exit(r.status??1)}\""
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.21.1"
  }
}
