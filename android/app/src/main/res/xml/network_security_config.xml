<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Self-hosted LAN/Tailscale deployments may use HTTP. Prefer Tailscale Serve HTTPS in production. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
