{
  "name": "showme-signaling",
  "private": true,
  "type": "module",
  "version": "0.3.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/worker-integration.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "configure": "node scripts/configure.mjs",
    "check": "npm run build && wrangler deploy --dry-run --outdir .dry-run"
  },
  "devDependencies": { "wrangler": "^4.0.0", "miniflare": "^4.0.0" }
}
