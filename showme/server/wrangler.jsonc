{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "showme-calls",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ShowMeRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShowMeRoom"] }],
  "vars": {
    "MAX_INSTALLATIONS_PER_DAY": "1000",
    "MAX_INSTALLATIONS_PER_IP_PER_DAY": "10",
    "MAX_ROOMS_PER_DAY": "1000",
    "MAX_ROOMS_PER_INSTALL_PER_DAY": "50",
    "SESSION_SECONDS": "1800"
  },
  "observability": { "enabled": false }
}
